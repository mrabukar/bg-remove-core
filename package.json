{
  "name": "bg-remove-core",
  "version": "0.2.0",
  "description": "Browser-side AI image background removal for JavaScript and TypeScript using ONNX Runtime, WebAssembly and optional WebGPU. Process images locally without uploading them to a server.",
  "keywords": [
    "background-removal",
    "remove-background",
    "image-background-removal",
    "background-remover",
    "remove-image-background",
    "image-processing",
    "image-segmentation",
    "transparent-background",
    "onnx",
    "webassembly",
    "wasm",
    "webgpu",
    "javascript",
    "typescript",
    "browser",
    "client-side",
    "privacy"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrabukar/bg-remove-core.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.4.5"
  },
  "devDependencies": {
    "typescript": "^5.8"
  }
}
